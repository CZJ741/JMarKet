<!-- pages/report/report.wxml -->
<view class="container">
  <view class="report-notice">
    <text>共同维护黄师互助良好秩序，对诈骗、违禁代课、恶意骚扰等行为将从严处置。</text>
  </view>

  <view class="card">
    <view class="form-title">请选择举报原因 <text class="required">*</text></view>
    <view class="reason-list">
      <view
        wx:for="{{reasons}}"
        wx:key="*this"
        class="reason-item {{selectedReason === item ? 'selected' : ''}}"
        bindtap="onSelectReason"
        data-reason="{{item}}"
      >
        <text class="radio-circle {{selectedReason === item ? 'checked' : ''}}"></text>
        <text class="reason-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-title">补充详细说明 (选填)</view>
    <textarea
      class="report-textarea"
      placeholder="请尽量提供详细信息，如具体聊天证据或失联情况等"
      value="{{detail}}"
      bindinput="onInputDetail"
      maxlength="300"
    ></textarea>
  </view>

  <view class="action-box">
    <button class="btn-primary" bindtap="submitReport">提交举报</button>
  </view>

  <view class="disclaimer-bar">
    <view class="disclaimer-text">恶意虚假举报将扣除信用分或限制使用平台服务。</view>
  </view>
</view>
