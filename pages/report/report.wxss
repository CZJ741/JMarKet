/* pages/report/report.wxss */
.container {
  padding-bottom: 40rpx;
}

.report-notice {
  background: #fff1f0;
  border: 1rpx solid #ffa39e;
  color: #cf1322;
  font-size: 24rpx;
  line-height: 1.5;
  padding: 18rpx 24rpx;
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 20rpx;
}

.required {
  color: #ff4d4f;
}

.reason-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.reason-item {
  display: flex;
  align-items: center;
  padding: 16rpx 10rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.radio-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  margin-right: 18rpx;
}

.radio-circle.checked {
  border-color: #ff4d4f;
  background-color: #ff4d4f;
}

.reason-text {
  font-size: 28rpx;
  color: #434343;
}

.reason-item.selected .reason-text {
  color: #cf1322;
  font-weight: 500;
}

.report-textarea {
  background: #fafafa;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  width: 100%;
  height: 180rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
}

.action-box {
  margin: 36rpx 24rpx;
}
