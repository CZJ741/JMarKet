/* pages/publish/publish.wxss */
.container {
  padding-bottom: 40rpx;
}

.safe-notice {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: flex-start;
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
}

.notice-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #d48806;
  line-height: 1.4;
}

.form-card {
  margin-top: 16rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 20rpx;
}

.required {
  color: #ff4d4f;
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.cat-chip {
  background: #f5f5f5;
  border: 1rpx solid #e8e8e8;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.cat-chip.selected {
  background: #e6f7ff;
  border-color: #1890ff;
  color: #1890ff;
}

.chip-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.chip-label {
  font-size: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 10rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 500;
  color: #595959;
  margin-bottom: 12rpx;
}

.input-box {
  background: #f9fbfd;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.textarea-box {
  background: #f9fbfd;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  width: 100%;
  height: 160rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.action-box {
  margin: 36rpx 24rpx;
}

/* 模态弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-card {
  width: 82%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 36rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  color: #52c41a;
  margin-bottom: 16rpx;
}

.modal-tips {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.share-box {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 24rpx;
  color: #333333;
  white-space: pre-wrap;
  max-height: 260rpx;
  overflow-y: auto;
  border: 1rpx dashed #d9d9d9;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.modal-actions button {
  flex: 1;
}
