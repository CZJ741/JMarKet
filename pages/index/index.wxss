/* pages/index/index.wxss */
.container {
  padding-bottom: 30rpx;
}

.banner {
  background: linear-gradient(135deg, #1890ff, #36cfc9);
  color: #ffffff;
  padding: 30rpx 28rpx;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
}

.banner-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.banner-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 分类滚动条 */
.category-bar {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 16rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.cat-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 26rpx;
  margin: 0 10rpx;
  background-color: #f0f2f5;
  color: #595959;
  border-radius: 32rpx;
  font-size: 26rpx;
  transition: all 0.2s;
  flex-shrink: 0;
}

.cat-item.active {
  background-color: #e6f7ff;
  color: #1890ff;
  font-weight: 600;
  border: 1rpx solid #91d5ff;
}

/* 列表卡片 */
.order-list {
  margin-top: 10rpx;
}

.order-card {
  transition: transform 0.1s;
}

.order-card:active {
  transform: scale(0.99);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.tag-takeout { background: #fff7e6; color: #fa8c16; }
.tag-express { background: #e6f7ff; color: #1890ff; }
.tag-market  { background: #f6ffed; color: #52c41a; }
.tag-nail    { background: #fff0f6; color: #eb2f96; }
.tag-tutor   { background: #f9f0ff; color: #722ed1; }
.tag-exchange{ background: #e6fffb; color: #13c2c2; }

.price-box {
  color: #ff4d4f;
  font-weight: 600;
}

.price-symbol {
  font-size: 24rpx;
}

.price-num {
  font-size: 36rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #262626;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.order-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
  color: #8c8c8c;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #f0f0f0;
}

.meta-item {
  display: flex;
  align-items: center;
}

.meta-icon {
  margin-right: 6rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
}

.order-status {
  font-size: 24rpx;
  color: #52c41a;
  background: #f6ffed;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.btn-grab {
  background: #1890ff;
  color: #ffffff;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  margin: 0;
  line-height: 1.5;
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8c8c8c;
}
